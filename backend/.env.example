# Application
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/shielder_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key
JWT_REFRESH_EXPIRES_IN=30d

# CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Email (Optional - for future implementation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password

# Contact form CAPTCHA (required for production contact submissions)
# Use the secret key from your reCAPTCHA / CAPTCHA provider dashboard.
CONTACT_CAPTCHA_SECRET=your-captcha-secret

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Unified Storage (Local filesystem + S3-compatible)
STORAGE_PROVIDER=local

# Private access signing (used for non-public assets like profile images & contact attachments)
PRIVATE_URL_SIGNING_SECRET=dev-private-url-signing-secret
PRIVATE_URL_TTL_SECONDS=600

# Centralized limits for image/document uploads
IMAGE_MAX_FILE_SIZE=5242880
DOCUMENT_MAX_FILE_SIZE=5242880

# Optional S3-compatible config (only needed when STORAGE_PROVIDER=s3)
PRODUCT_IMAGE_S3_BUCKET=
PRODUCT_IMAGE_S3_REGION=us-east-1
PRODUCT_IMAGE_S3_ENDPOINT=
PRODUCT_IMAGE_S3_ACCESS_KEY_ID=
PRODUCT_IMAGE_S3_SECRET_ACCESS_KEY=
PRODUCT_IMAGE_PUBLIC_BASE_URL=

# Logging
LOG_LEVEL=info

# EPG Payment Gateway
# EPG_PROVIDER: mock (development only) | sandbox | production
# NEVER set EPG_PROVIDER=mock in production — the server will fail to start.
EPG_PROVIDER=mock
EPG_API_KEY=your-epg-api-key
EPG_SECRET_KEY=your-epg-secret-key
EPG_BASE_URL=https://api.epg.gateway.sa/v1
# Optional production base URL (when EPG_PROVIDER=production)
# EPG_PRODUCTION_BASE_URL=https://api.epg.gateway.sa/v1
