{
  "$schema": "file:///Users/mzubair/Documents/Professional/DevFlx/shielder/.vscode/schemas/package.schema.json",
  "name": "shielder-backend",
  "version": "1.0.0",
  "description": "Shielder Digital Platform - Enterprise Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/server.ts",
    "build": "prisma generate --schema=./src/database/prisma/schema.prisma && tsc && tsc-alias",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate --schema=./src/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./src/database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./src/database/prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=./src/database/prisma/schema.prisma",
    "seed:super-admin": "npx tsx src/scripts/seed-super-admin.ts",
    "seed:test-data": "npx tsx src/scripts/seed-test-data.ts",
    "backfill:product-arabic": "npx tsx src/scripts/backfill-product-arabic-translations.ts",
    "migrate:product-images": "npx tsx src/scripts/migrate-product-image-paths.ts",
    "migrate:product-images:dry-run": "npx tsx src/scripts/migrate-product-image-paths.ts -- --dry-run",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:auth": "jest src/modules/auth/__tests__/trusted-device.test.ts src/modules/auth/__tests__/trusted-device-status.test.ts src/modules/auth/__tests__/trusted-devices-revoke.test.ts --runInBand --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "perf:baseline": "tsx scripts/performance-baseline.ts",
    "email:check": "tsx -r tsconfig-paths/register scripts/check-email-config.ts"
  },
  "keywords": [
    "shielder",
    "industrial-filters",
    "backend",
    "api",
    "enterprise"
  ],
  "author": "Shielder Team",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@prisma/client": "^5.22.0",
    "@types/adm-zip": "^0.5.7",
    "@vitalets/google-translate-api": "^9.2.1",
    "adm-zip": "^0.5.16",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "sanitize-html": "^2.8.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.0",
    "pdfkit": "^0.17.2",
    "redis": "^5.12.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^7.0.9",
    "@types/pdfkit": "^0.17.5",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "eslint": "^9.17.0",
    "jest": "^30.3.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9.0.0"
  }
}
